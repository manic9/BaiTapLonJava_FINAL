<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="16.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.esports.manager.controller.TeamController">

    <!-- ==================== FILTER & ACTION BAR ==================== -->
    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="card">
        <HBox alignment="CENTER_LEFT" spacing="8.0"
              style="-fx-background-color: #0E131D; -fx-border-color: #1E293B; -fx-border-radius: 9px; -fx-background-radius: 9px; -fx-padding: 2 10 2 12;">
            <FontIcon iconColor="#64748B" iconLiteral="fas-search" iconSize="13" />
            <TextField fx:id="txtSearch" prefWidth="250.0" promptText="Tìm tên đội, tag, HLV, mã đội..."
                       style="-fx-background-color: transparent; -fx-border-color: transparent;" />
        </HBox>

        <ComboBox fx:id="cbRegionFilter" prefWidth="175.0" promptText="Tất cả khu vực" />

        <Button onAction="#handleResetFilters" styleClass="btn-secondary" text="Đặt lại">
            <graphic><FontIcon iconColor="#94A3B8" iconLiteral="fas-redo" iconSize="12" /></graphic>
        </Button>

        <Region HBox.hgrow="ALWAYS" />

        <Label fx:id="lblResultCount" style="-fx-text-fill: #94A3B8; -fx-font-weight: 600;" text="0 đội tuyển" />

        <Button onAction="#handleCreateTeam" styleClass="btn-primary" text="Thêm Đội Tuyển">
            <graphic><FontIcon iconColor="WHITE" iconLiteral="fas-plus" iconSize="12" /></graphic>
        </Button>
    </HBox>

    <!-- ==================== TEAMS DATA TABLE ==================== -->
    <TableView fx:id="teamTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="105.0" text="MÃ ĐỘI" />
            <TableColumn fx:id="colTag" prefWidth="90.0" text="TAG" />
            <TableColumn fx:id="colName" prefWidth="220.0" text="TÊN ĐỘI TUYỂN" />
            <TableColumn fx:id="colRegion" prefWidth="120.0" text="KHU VỰC" />
            <TableColumn fx:id="colCoach" prefWidth="145.0" text="HUẤN LUYỆN VIÊN" />
            <TableColumn fx:id="colRoster" prefWidth="125.0" text="ĐỘI HÌNH" />
            <TableColumn fx:id="colFounded" prefWidth="95.0" text="THÀNH LẬP" />
            <TableColumn fx:id="colEmail" prefWidth="200.0" text="EMAIL LIÊN HỆ" />
            <TableColumn fx:id="colActions" prefWidth="185.0" text="THAO TÁC" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

</VBox>