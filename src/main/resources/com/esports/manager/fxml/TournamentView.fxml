<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="16.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.esports.manager.controller.TournamentController">

    <!-- ==================== FILTER & ACTION BAR ==================== -->
    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="card">
        <HBox alignment="CENTER_LEFT" spacing="8.0"
              style="-fx-background-color: #0E131D; -fx-border-color: #1E293B; -fx-border-radius: 9px; -fx-background-radius: 9px; -fx-padding: 2 10 2 12;">
            <FontIcon iconColor="#64748B" iconLiteral="fas-search" iconSize="13" />
            <TextField fx:id="txtSearch" prefWidth="260.0" promptText="Tìm tên giải, game, đơn vị tổ chức..."
                       style="-fx-background-color: transparent; -fx-border-color: transparent;" />
        </HBox>

        <ComboBox fx:id="cbGameFilter" prefWidth="185.0" promptText="Tất cả tựa game" />
        <ComboBox fx:id="cbStatusFilter" prefWidth="175.0" promptText="Tất cả trạng thái" />

        <Button onAction="#handleResetFilters" styleClass="btn-secondary" text="Đặt lại">
            <graphic><FontIcon iconColor="#94A3B8" iconLiteral="fas-redo" iconSize="12" /></graphic>
        </Button>

        <Region HBox.hgrow="ALWAYS" />

        <Label fx:id="lblResultCount" style="-fx-text-fill: #94A3B8; -fx-font-weight: 600;" text="0 giải đấu" />

        <Button onAction="#openCreateModal" styleClass="btn-primary" text="Tạo Giải Đấu">
            <graphic><FontIcon iconColor="WHITE" iconLiteral="fas-plus" iconSize="12" /></graphic>
        </Button>
    </HBox>

    <!-- ==================== TOURNAMENT DATA TABLE ==================== -->
    <TableView fx:id="tournamentTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="105.0" text="MÃ GIẢI" />
            <TableColumn fx:id="colName" prefWidth="250.0" text="TÊN GIẢI ĐẤU" />
            <TableColumn fx:id="colGame" prefWidth="150.0" text="TỰA GAME" />
            <TableColumn fx:id="colFormat" prefWidth="175.0" text="THỂ THỨC" />
            <TableColumn fx:id="colTeams" prefWidth="95.0" text="SỐ ĐỘI" />
            <TableColumn fx:id="colPrize" prefWidth="120.0" text="QUỸ THƯỞNG" />
            <TableColumn fx:id="colDates" prefWidth="165.0" text="THỜI GIAN" />
            <TableColumn fx:id="colStatus" prefWidth="130.0" text="TRẠNG THÁI" />
            <TableColumn fx:id="colActions" prefWidth="195.0" text="THAO TÁC" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

</VBox>