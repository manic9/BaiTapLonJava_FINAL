<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="16.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.esports.manager.controller.PlayerController">

    <!-- ==================== FILTER & ACTION BAR ==================== -->
    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="card">
        <HBox alignment="CENTER_LEFT" spacing="8.0"
              style="-fx-background-color: #0E131D; -fx-border-color: #1E293B; -fx-border-radius: 9px; -fx-background-radius: 9px; -fx-padding: 2 10 2 12;">
            <FontIcon iconColor="#64748B" iconLiteral="fas-search" iconSize="13" />
            <TextField fx:id="txtSearch" prefWidth="235.0" promptText="Tìm IGN, họ tên, quốc tịch..."
                       style="-fx-background-color: transparent; -fx-border-color: transparent;" />
        </HBox>

        <ComboBox fx:id="cbTeamFilter" prefWidth="215.0" promptText="Tất cả đội tuyển" />
        <ComboBox fx:id="cbRoleFilter" prefWidth="170.0" promptText="Tất cả vị trí" />

        <Button onAction="#handleResetFilters" styleClass="btn-secondary" text="Đặt lại">
            <graphic><FontIcon iconColor="#94A3B8" iconLiteral="fas-redo" iconSize="12" /></graphic>
        </Button>

        <Region HBox.hgrow="ALWAYS" />

        <Label fx:id="lblResultCount" style="-fx-text-fill: #94A3B8; -fx-font-weight: 600;" text="0 tuyển thủ" />

        <Button onAction="#handleCreatePlayer" styleClass="btn-primary" text="Thêm Tuyển Thủ">
            <graphic><FontIcon iconColor="WHITE" iconLiteral="fas-user-plus" iconSize="12" /></graphic>
        </Button>
    </HBox>

    <!-- ==================== PLAYERS DATA TABLE ==================== -->
    <TableView fx:id="playerTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="100.0" text="MÃ" />
            <TableColumn fx:id="colIgn" prefWidth="195.0" text="IN-GAME NAME (IGN)" />
            <TableColumn fx:id="colFullName" prefWidth="185.0" text="HỌ VÀ TÊN" />
            <TableColumn fx:id="colTeam" prefWidth="195.0" text="ĐỘI TUYỂN" />
            <TableColumn fx:id="colRole" prefWidth="135.0" text="VỊ TRÍ" />
            <TableColumn fx:id="colNationality" prefWidth="115.0" text="QUỐC TỊCH" />
            <TableColumn fx:id="colAge" prefWidth="75.0" text="TUỔI" />
            <TableColumn fx:id="colKda" prefWidth="105.0" text="KDA RATIO" />
            <TableColumn fx:id="colActions" prefWidth="120.0" text="THAO TÁC" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

</VBox>