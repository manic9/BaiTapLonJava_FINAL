<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="16.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.esports.manager.controller.StandingsController">

    <!-- ==================== FILTER & ACTION BAR ==================== -->
    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="card">
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <FontIcon iconColor="#7C5CFC" iconLiteral="fas-trophy" iconSize="15" />
            <Label style="-fx-font-weight: bold; -fx-text-fill: #F8FAFC;" text="Giải đấu:" />
        </HBox>

        <ComboBox fx:id="cbTournament" prefWidth="285.0" promptText="Chọn giải đấu" />

        <HBox alignment="CENTER_LEFT" spacing="8.0"
              style="-fx-background-color: #0E131D; -fx-border-color: #1E293B; -fx-border-radius: 9px; -fx-background-radius: 9px; -fx-padding: 2 10 2 12;">
            <FontIcon iconColor="#64748B" iconLiteral="fas-search" iconSize="13" />
            <TextField fx:id="txtSearch" prefWidth="210.0" promptText="Lọc tên hoặc tag đội..."
                       style="-fx-background-color: transparent; -fx-border-color: transparent;" />
        </HBox>

        <Region HBox.hgrow="ALWAYS" />

        <Label style="-fx-text-fill: #64748B; -fx-font-size: 11.5px;" text="Thắng: +3đ  •  Thua: 0đ" />

        <Button onAction="#handleRecalculate" styleClass="btn-primary" text="Tính lại BXH">
            <graphic><FontIcon iconColor="WHITE" iconLiteral="fas-sync-alt" iconSize="12" /></graphic>
        </Button>
    </HBox>

    <!-- ==================== STANDINGS DATA TABLE ==================== -->
    <TableView fx:id="standingsTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colRank" prefWidth="95.0" text="HẠNG" />
            <TableColumn fx:id="colTag" prefWidth="95.0" text="TAG" />
            <TableColumn fx:id="colTeam" prefWidth="260.0" text="ĐỘI TUYỂN" />
            <TableColumn fx:id="colPlayed" prefWidth="105.0" text="SỐ TRẬN" />
            <TableColumn fx:id="colWins" prefWidth="105.0" text="THẮNG (W)" />
            <TableColumn fx:id="colLosses" prefWidth="105.0" text="THUA (L)" />
            <TableColumn fx:id="colDiff" prefWidth="115.0" text="HIỆU SỐ (+/-)" />
            <TableColumn fx:id="colWinRate" prefWidth="120.0" text="TỶ LỆ THẮNG" />
            <TableColumn fx:id="colPoints" prefWidth="115.0" text="ĐIỂM (PTS)" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

</VBox>