<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.Group?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="16.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.esports.manager.controller.BracketController">

    <!-- ==================== CONTROL & CHAMPION BAR ==================== -->
    <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="card">
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <FontIcon iconColor="#7C5CFC" iconLiteral="fas-trophy" iconSize="15" />
            <Label style="-fx-font-weight: bold; -fx-text-fill: #F8FAFC;" text="%bracket.lbl_tournament" />
        </HBox>

        <ComboBox fx:id="cbTournament" prefWidth="310.0" promptText="%bracket.prompt_select" />

        <Button onAction="#handleGenerateBracket" styleClass="btn-secondary" text="%bracket.btn_generate">
            <graphic><FontIcon iconColor="#00D4FF" iconLiteral="fas-sync-alt" iconSize="12" /></graphic>
        </Button>

        <HBox alignment="CENTER" spacing="5.0">
            <Button onAction="#handleZoomOut" styleClass="btn-secondary" text="−" />
            <Label fx:id="lblZoom" minWidth="48.0" alignment="CENTER"
                   style="-fx-text-fill: #CBD5E1; -fx-font-size: 11px;" text="100%" />
            <Button onAction="#handleZoomIn" styleClass="btn-secondary" text="+" />
            <Button onAction="#handleZoomReset" styleClass="btn-secondary" text="%bracket.zoom_reset" />
        </HBox>

        <Region HBox.hgrow="ALWAYS" />

        <!-- Champion Banner (Chỉ hiện khi trận Chung kết đã có đội vô địch) -->
        <HBox fx:id="championBanner" alignment="CENTER_LEFT" managed="false" spacing="10.0" visible="false"
              style="-fx-background-color: rgba(245, 158, 11, 0.14); -fx-border-color: rgba(245, 158, 11, 0.45); -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-padding: 7 14;">
            <FontIcon iconColor="#F59E0B" iconLiteral="fas-crown" iconSize="15" />
            <Label style="-fx-text-fill: #FBBF24; -fx-font-weight: bold; -fx-font-size: 12px;" text="%bracket.lbl_champion" />
            <Label fx:id="lblChampionName" style="-fx-text-fill: #F8FAFC; -fx-font-weight: bold; -fx-font-size: 13px;" text="TEAM" />
        </HBox>

        <Label style="-fx-text-fill: #64748B; -fx-font-size: 11.5px;" text="%bracket.hint_click" />
    </HBox>

    <!-- ==================== INTERACTIVE BRACKET CANVAS ==================== -->
    <ScrollPane fx:id="scrollPane" fitToHeight="false" fitToWidth="false" pannable="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: #121722; -fx-border-color: #1E293B; -fx-border-radius: 14px; -fx-background-radius: 14px;">
        <Group>
            <children>
                <Pane fx:id="bracketCanvas" minHeight="560.0" minWidth="1040.0"
                      style="-fx-background-color: #0E131D;">
                    <padding>
                        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
                    </padding>
                </Pane>
            </children>
        </Group>
    </ScrollPane>

</VBox>
