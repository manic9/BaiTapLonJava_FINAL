<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="16.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.esports.manager.controller.RegistrationController"
      fx:bundle="messages">

    <!-- ==================== FILTER & ACTION BAR ==================== -->
    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="card">
        <HBox alignment="CENTER_LEFT" spacing="8.0"
              style="-fx-background-color: #0E131D; -fx-border-color: #1E293B; -fx-border-radius: 9px; -fx-background-radius: 9px; -fx-padding: 2 10 2 12;">
            <FontIcon iconColor="#64748B" iconLiteral="fas-search" iconSize="13" />
            <TextField fx:id="txtSearch" prefWidth="230.0" promptText="%reg.search_prompt"
                       style="-fx-background-color: transparent; -fx-border-color: transparent;" />
        </HBox>

        <ComboBox fx:id="cbTournamentFilter" prefWidth="235.0" promptText="%filter.all_tournaments" />
        <ComboBox fx:id="cbStatusFilter" prefWidth="165.0" promptText="%filter.all_statuses" />

        <Button onAction="#handleResetFilters" styleClass="btn-secondary" text="%btn.reset">
            <graphic><FontIcon iconColor="#94A3B8" iconLiteral="fas-redo" iconSize="12" /></graphic>
        </Button>

        <Region HBox.hgrow="ALWAYS" />

        <!-- Language Toggle -->
        <StackPane fx:id="langTogglePane" style="-fx-background-color: #1E293B; -fx-background-radius: 15px; -fx-min-width: 30px; -fx-max-width: 30px; -fx-min-height: 30px; -fx-max-height: 30px; -fx-cursor: hand;"
                   onMouseClicked="#handleToggleLanguage">
            <ImageView fx:id="ivLangFlag" fitWidth="24" fitHeight="24" preserveRatio="true" />
        </StackPane>

        <Label fx:id="lblResultCount" style="-fx-text-fill: #94A3B8; -fx-font-weight: 600;" text="0" />

        <Button onAction="#handleCreateRegistration" styleClass="btn-primary" text="%reg.btn_create">
            <graphic><FontIcon iconColor="WHITE" iconLiteral="fas-plus" iconSize="12" /></graphic>
        </Button>
    </HBox>

    <!-- ==================== REGISTRATIONS DATA TABLE ==================== -->
    <TableView fx:id="registrationTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="105.0" text="%col.reg_id" />
            <TableColumn fx:id="colTournament" prefWidth="230.0" text="%col.tournament" />
            <TableColumn fx:id="colTeam" prefWidth="205.0" text="%col.team" />
            <TableColumn fx:id="colSeed" prefWidth="85.0" text="%col.seed" />
            <TableColumn fx:id="colRegisteredAt" prefWidth="135.0" text="%col.reg_date" />
            <TableColumn fx:id="colNotes" prefWidth="235.0" text="%col.notes" />
            <TableColumn fx:id="colStatus" prefWidth="125.0" text="%col.status" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

</VBox>
