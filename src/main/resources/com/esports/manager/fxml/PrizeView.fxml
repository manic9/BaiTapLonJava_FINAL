<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="16.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.esports.manager.controller.PrizeController">

    <!-- ==================== SUMMARY KPI STRIP ==================== -->
    <HBox spacing="16.0">
        <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="card" HBox.hgrow="ALWAYS">
            <StackPane style="-fx-background-color: rgba(124, 92, 252, 0.16); -fx-background-radius: 11px; -fx-padding: 12;">
                <FontIcon iconColor="#7C5CFC" iconLiteral="fas-coins" iconSize="18" />
            </StackPane>
            <VBox spacing="2.0">
                <Label styleClass="kpi-label" text="TỔNG CƠ CẤU GIẢI THƯỞNG" />
                <Label fx:id="lblTotalAllocated" style="-fx-font-size: 21px; -fx-font-weight: bold; -fx-text-fill: #F8FAFC;" text="\$0" />
            </VBox>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="card" HBox.hgrow="ALWAYS">
            <StackPane style="-fx-background-color: rgba(16, 185, 129, 0.16); -fx-background-radius: 11px; -fx-padding: 12;">
                <FontIcon iconColor="#10B981" iconLiteral="fas-check-circle" iconSize="18" />
            </StackPane>
            <VBox spacing="2.0">
                <Label styleClass="kpi-label" text="ĐÃ GIẢI NGÂN" />
                <Label fx:id="lblTotalPaid" style="-fx-font-size: 21px; -fx-font-weight: bold; -fx-text-fill: #10B981;" text="\$0" />
            </VBox>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="card" HBox.hgrow="ALWAYS">
            <StackPane style="-fx-background-color: rgba(0, 212, 255, 0.14); -fx-background-radius: 11px; -fx-padding: 12;">
                <FontIcon iconColor="#00D4FF" iconLiteral="fas-clock" iconSize="18" />
            </StackPane>
            <VBox spacing="2.0">
                <Label styleClass="kpi-label" text="CHỜ TRAO GIẢI" />
                <Label fx:id="lblTotalPending" style="-fx-font-size: 21px; -fx-font-weight: bold; -fx-text-fill: #00D4FF;" text="\$0" />
            </VBox>
        </HBox>
    </HBox>

    <!-- ==================== FILTER & ACTION BAR ==================== -->
    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="card">
        <HBox alignment="CENTER_LEFT" spacing="8.0"
              style="-fx-background-color: #0E131D; -fx-border-color: #1E293B; -fx-border-radius: 9px; -fx-background-radius: 9px; -fx-padding: 2 10 2 12;">
            <FontIcon iconColor="#64748B" iconLiteral="fas-search" iconSize="13" />
            <TextField fx:id="txtSearch" prefWidth="220.0" promptText="Tìm hạng mục, tên đội nhận..."
                       style="-fx-background-color: transparent; -fx-border-color: transparent;" />
        </HBox>

        <ComboBox fx:id="cbTournamentFilter" prefWidth="245.0" promptText="Tất cả giải đấu" />
        <ComboBox fx:id="cbPaidFilter" prefWidth="175.0" promptText="Tất cả trạng thái" />

        <Button onAction="#handleResetFilters" styleClass="btn-secondary" text="Đặt lại">
            <graphic><FontIcon iconColor="#94A3B8" iconLiteral="fas-redo" iconSize="12" /></graphic>
        </Button>

        <Region HBox.hgrow="ALWAYS" />

        <Button onAction="#handleCreatePrize" styleClass="btn-primary" text="Thêm Hạng Mục Thưởng">
            <graphic><FontIcon iconColor="WHITE" iconLiteral="fas-plus" iconSize="12" /></graphic>
        </Button>
    </HBox>

    <!-- ==================== PRIZE DATA TABLE ==================== -->
    <TableView fx:id="prizeTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="105.0" text="MÃ" />
            <TableColumn fx:id="colTournament" prefWidth="235.0" text="GIẢI ĐẤU" />
            <TableColumn fx:id="colPlacement" prefWidth="190.0" text="THỨ HẠNG" />
            <TableColumn fx:id="colPercent" prefWidth="105.0" text="TỶ LỆ (%)" />
            <TableColumn fx:id="colAmount" prefWidth="145.0" text="GIÁ TRỊ THƯỞNG" />
            <TableColumn fx:id="colTeam" prefWidth="205.0" text="ĐỘI NHẬN GIẢI" />
            <TableColumn fx:id="colPaid" prefWidth="135.0" text="TRẠNG THÁI" />
            <TableColumn fx:id="colActions" prefWidth="185.0" text="THAO TÁC" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

</VBox>