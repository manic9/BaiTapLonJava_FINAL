# ============================================================================
# NEXUS ARENA - CẤU HÌNH KẾT NỐI MICROSOFT SQL SERVER
# Sao chép file này thành "config/db.properties" và điền thông tin kết nối.
# Hỗ trợ ghi đè bằng biến môi trường: ESPORTS_DB_HOST, ESPORTS_DB_PORT,
# ESPORTS_DB_NAME, ESPORTS_DB_AUTH_MODE, ESPORTS_DB_USER, ESPORTS_DB_PASSWORD
# ============================================================================

db.host=localhost
db.port=1433
db.name=EsportsDB

# Chế độ xác thực: SQL_SERVER hoặc WINDOWS
db.authMode=SQL_SERVER

# Tài khoản ứng dụng (không dùng sa)
db.username=esports_app
db.password=

# Bảo mật đường truyền JDBC
db.encrypt=true
db.trustServerCertificate=true
db.loginTimeoutSeconds=5